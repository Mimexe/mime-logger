{
  "name": "mime-logger",
  "version": "2.0.1",
  "description": "A simple logger for Node.js",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "bugs": {
    "url": "https://github.com/Mimexe/mime-logger/issues",
    "email": "mime+bugs@mimedev.fr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mimexe/mime-logger.git"
  },
  "homepage": "https://github.com/Mimexe/mime-logger#readme",
  "keywords": [
    "cli",
    "logger"
  ],
  "type": "module",
  "author": "Mime <mime@mimedev.fr> (https://mimedev.fr)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "latest",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ansis": "^4.2.0"
  },
  "files": [
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.mts",
    "dist/index.d.cts"
  ]
