{
  "name": "mime-logger",
  "version": "2.2.0",
  "description": "A simple logger for Node.js",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "bugs": {
    "url": "https://github.com/Mimexe/mime-logger/issues",
    "email": "mime+bugs@mimedev.fr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mimexe/mime-logger.git"
  },
  "homepage": "https://github.com/Mimexe/mime-logger#readme",
  "keywords": [
    "cli",
    "logger"
  ],
  "type": "module",
  "author": "Mime <mime@mimedev.fr> (https://mimedev.fr)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsdown": "latest",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ansis": "^4.3.0"
  },
  "files": [
    "dist/"
  ]
}
